# ============================================================================
# CONFIGURACIÓN GENERAL Y ZONA HORARIA
# ============================================================================
NODE_ENV=production
TZ=America/Bogota
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# ============================================================================
# BASE DE DATOS PRINCIPAL (LOTERÍAS Y ACUMULADOS - MariaDB/MySQL)
# ============================================================================
DB_MAIN_HOST=172.20.1.92
DB_MAIN_PORT=3306
DB_MAIN_USER=replace_with_main_db_user
DB_MAIN_PASSWORD=replace_with_main_db_password
DB_MAIN_NAME=chatbot
DB_MAIN_POOL_LIMIT=10
DB_MAIN_CONNECT_TIMEOUT=10000

# ============================================================================
# BASE DE DATOS DE AUTENTICACIÓN ADMINISTRATIVA (PANEL EDICIÓN - MariaDB/MySQL)
# ============================================================================
DB_AUTH_HOST=172.20.1.92
DB_AUTH_PORT=3306
DB_AUTH_USER=replace_with_auth_db_user
DB_AUTH_PASSWORD=replace_with_auth_db_password
DB_AUTH_NAME=bdpersona
DB_AUTH_POOL_LIMIT=5
DB_AUTH_CONNECT_TIMEOUT=10000

# ============================================================================
# BASE DE DATOS EXTERNA POWERBI (TABLA INFORESULTADOS - MySQL 8)
# ============================================================================
DB_POWERBI_HOST=aplicacionesgane.cloud
DB_POWERBI_PORT=5010
DB_POWERBI_USER=replace_with_powerbi_db_user
DB_POWERBI_PASSWORD=replace_with_powerbi_db_password
DB_POWERBI_NAME=POWERBI
DB_POWERBI_POOL_LIMIT=5
DB_POWERBI_CONNECT_TIMEOUT=15000
DB_POWERBI_SSL=false
DB_POWERBI_MAX_RETRIES=3
DB_POWERBI_RETRY_DELAY_MS=1500

# ============================================================================
# SERVICIOS EXTERNOS Y SCRAPING DE RESULTADOS / ACUMULADOS
# ============================================================================
API_RESULTADOS_BASE_URL=http://172.20.1.221:7080/api/v1/resultados
SCRAPER_URL_BALOTO=https://baloto.com/resultados
SCRAPER_URL_MILOTO=https://baloto.com/miloto/resultados/
SCRAPER_URL_COLORLOTO=https://baloto.com/colorloto/resultados
SCRAPER_URL_CHANCE_MILLONARIO=https://www.chancemillonario.com/resultados.php
SCRAPER_URL_DOBLE_CHANCE=https://supergirosnortedelvalle.com/juegos/doble-chance/
SCRAPER_HTTP_TIMEOUT_MS=12000
SCRAPER_MAX_RETRIES=3
SCRAPER_ALLOW_INSECURE_TLS_FALLBACK=true

# ============================================================================
# SINCRONIZACIÓN AUTOMÁTICA Y SEGURIDAD DE ESCRITURA
# ============================================================================
AUTO_SYNC_ENABLED=true
AUTO_SYNC_INTERVAL_MS=3600000
AUTO_SYNC_ON_STARTUP=true
SYNC_API_TOKEN=replace_with_sync_api_token
SYNC_VERSION_TAG=WS-SCRAPER-2.0

# ============================================================================
# CARRUSEL DE IMÁGENES
# ============================================================================
CAROUSEL_IMAGES_DIR=../frontend/public/img/carousel
