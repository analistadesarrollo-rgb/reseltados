---
import CacheManagerScript from '../components/CacheManagerScript.astro';
import '../styles/global.css';

interface Props {
  title?: string;
}

const { title = 'Resultados' } = Astro.props;
const appVersion = import.meta.env.PUBLIC_APP_BUILD_VERSION || 'dev';
---
<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="color-scheme" content="light only" />
    <meta name="app-version" content={appVersion} />
    <meta http-equiv="Cache-Control" content="no-store, no-cache, must-revalidate, max-age=0" />
    <meta http-equiv="Pragma" content="no-cache" />
    <meta http-equiv="Expires" content="0" />
    <meta
      name="viewport"
      content="width=device-width, user-scalable=no, initial-scale=1.0, maximum-scale=1.0, minimum-scale=1.0"
    />
    <title>{title}</title>
  </head>
  <body>
    <slot />
    <CacheManagerScript autoWatch={true} pollIntervalMs={60000} />
  </body>
</html>
