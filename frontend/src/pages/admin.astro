---
---
<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Administración de Acumulados y Baloto</title>
    <style>
      :root {
        --bg: #eef2f7;
        --surface: #ffffff;
        --border: #dce3ee;
        --navy: #061b4e;
        --primary: #0d47a1;
        --gold: #f8bb02;
        --muted: #64748b;
        --text: #0f172a;
      }

      * { box-sizing: border-box; }

      body {
        font-family: 'Segoe UI', system-ui, -apple-system, Roboto, Arial, sans-serif;
        background:
          radial-gradient(circle at 18% 20%, rgba(248, 187, 2, 0.14) 0%, transparent 45%),
          linear-gradient(135deg, #041236 0%, #0d47a1 60%, #072262 100%);
        margin: 0;
        padding: 24px 16px 48px;
        min-height: 100vh;
        display: flex;
        justify-content: center;
        align-items: flex-start;
      }

      .login-card {
        width: 100%;
        max-width: 430px;
        background: #ffffff;
        padding: 34px 32px;
        border-radius: 18px;
        border-top: 4px solid var(--gold);
        box-shadow: 0 24px 60px rgba(0, 0, 0, 0.42);
        margin-top: 9vh;
      }

      .login-badge {
        display: inline-block;
        font-size: 11px;
        font-weight: 800;
        letter-spacing: 0.7px;
        background: #dbeafe;
        color: #1e40af;
        padding: 4px 10px;
        border-radius: 999px;
        margin-bottom: 10px;
      }

      .login-card h2 {
        margin: 0 0 8px;
        font-size: 23px;
        color: var(--text);
      }

      .login-subtitle {
        margin: 0 0 22px;
        color: var(--muted);
        font-size: 14px;
      }

      .admin-panel {
        display: none;
        width: 100%;
        max-width: 1140px;
        background: var(--bg);
        padding: 24px;
        border-radius: 18px;
        box-shadow: 0 24px 60px rgba(0, 0, 0, 0.38);
      }

      .admin-topbar {
        background: linear-gradient(135deg, #061b4e 0%, #0d47a1 100%);
        border-bottom: 3px solid var(--gold);
        color: #ffffff;
        padding: 18px 22px;
        border-radius: 14px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 12px;
      }

      .admin-topbar h2 {
        margin: 0;
        font-size: 21px;
      }

      .form-group {
        margin-bottom: 14px;
      }

      .form-group label {
        display: block;
        font-weight: 700;
        font-size: 13px;
        margin-bottom: 6px;
        color: #334155;
      }

      .form-group input {
        width: 100%;
        padding: 10px 12px;
        border: 1.5px solid #cbd5e1;
        border-radius: 9px;
        font-size: 15px;
        outline: none;
        transition: border-color 0.2s, box-shadow 0.2s;
      }

      .form-group input:focus {
        border-color: var(--primary);
        box-shadow: 0 0 0 3px rgba(13, 71, 161, 0.14);
      }

      .input-wrap {
        position: relative;
      }

      .toggle-eye {
        position: absolute;
        right: 10px;
        top: 50%;
        transform: translateY(-50%);
        border: none;
        background: transparent;
        color: #64748b;
        cursor: pointer;
        padding: 4px;
      }

      .btn {
        background: linear-gradient(135deg, #0d47a1 0%, #1565c0 100%);
        color: #ffffff;
        border: none;
        padding: 11px 20px;
        border-radius: 10px;
        font-weight: 700;
        cursor: pointer;
        font-size: 14px;
        transition: all 0.2s;
      }

      .btn:hover {
        transform: translateY(-1px);
      }

      .btn-logout {
        background: #dc2626;
      }

      .alert {
        padding: 12px 15px;
        border-radius: 10px;
        margin-bottom: 16px;
        font-weight: 600;
        font-size: 14px;
        display: none;
      }

      .alert-error { background: #fee2e2; color: #991b1b; display: block; border: 1px solid #fecaca; }
      .alert-ok { background: #dcfce7; color: #166534; display: block; border: 1px solid #bbf7d0; }

      .section-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(310px, 1fr));
        gap: 20px;
        margin-top: 20px;
      }

      .box {
        background: #ffffff;
        border: 1px solid var(--border);
        border-radius: 14px;
        padding: 20px;
        box-shadow: 0 4px 12px rgba(15, 23, 42, 0.05);
      }

      .box h3 {
        margin: 0 0 16px;
        padding-bottom: 10px;
        border-bottom: 2px solid #f1f5f9;
        color: var(--navy);
        font-size: 17px;
      }

      .balls-inputs {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 12px;
        margin-bottom: 16px;
      }

      .ball-field {
        display: flex;
        flex-direction: column;
        align-items: center;
      }

      .ball-field label {
        font-size: 12px;
        text-align: center;
      }

      .ball-field input {
        width: 58px;
        height: 58px;
        border-radius: 50%;
        text-align: center;
        font-weight: 900;
        font-size: 20px;
        padding: 0;
        background: radial-gradient(circle at 32% 28%, #fff7ae 0%, #ffd700 50%, #d99b00 100%);
        color: #0f172a;
        border: 2px solid #eab308;
      }

      .ball-field.super input {
        background: radial-gradient(circle at 32% 28%, #fca5a5 0%, #dc2626 52%, #7f1d1d 100%);
        color: #ffffff;
        border-color: #ef4444;
      }
    </style>
  </head>
  <body>
    <!-- Formulario de Ingreso (equivalente a login_down/index.php) -->
    <div class="login-card" id="login-view">
      <span class="login-badge">ADMINISTRACIÓN DE RESULTADOS</span>
      <h2>Ingreso Administrativo</h2>
      <p class="login-subtitle">Edición manual de acumulados, Baloto y Revancha con sincronización automática PowerBI.</p>
      <div id="login-alert" class="alert"></div>
      <form id="login-form">
        <div class="form-group">
          <label for="uname">Usuario</label>
          <input type="text" id="uname" name="uname" autocomplete="off" required />
        </div>
        <div class="form-group">
          <label for="pass">Clave</label>
          <div class="input-wrap">
            <input type="password" id="pass" name="pass" required />
            <button type="button" id="toggle-pass" class="toggle-eye" aria-label="Mostrar u ocultar clave">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
                <circle cx="12" cy="12" r="3" />
              </svg>
            </button>
          </div>
        </div>
        <button type="submit" class="btn" style="width: 100%;">Ingresar</button>
      </form>
    </div>

    <!-- Panel de Edición Manual (equivalente a login_down/editar/) -->
    <div class="admin-panel" id="admin-view">
      <div class="admin-topbar">
        <div>
          <h2>Panel de Edición Manual y Sincronización PowerBI</h2>
          <span style="font-size: 13px; color: #dbeafe;">Los cambios se sincronizan automáticamente con INFORESULTADOS</span>
        </div>
        <button type="button" class="btn btn-logout" id="btn-logout">Cerrar Sesión</button>
      </div>
      <div id="admin-alert" class="alert" style="margin-top: 16px;"></div>

      <div class="section-grid">
        <!-- 1. Acumulados -->
        <div class="box">
          <h3>Actualizar Acumulados</h3>
          <form id="form-acumulados">
            <input type="hidden" id="row_id" value="1" />
            <div class="form-group">
              <label>Acum 3 cifras</label>
              <input type="text" id="edit_acum_3cifras" required />
            </div>
            <div class="form-group">
              <label>Acum 4 cifras</label>
              <input type="text" id="edit_acum_4cifras" required />
            </div>
            <div class="form-group">
              <label>Acum Chance Millonario</label>
              <input type="text" id="edit_acum_chmillonario" required />
            </div>
            <div class="form-group">
              <label>Acum Baloto</label>
              <input type="text" id="edit_acum_baloto" required />
            </div>
            <div class="form-group">
              <label>Acum Revancha</label>
              <input type="text" id="edit_acum_revancha" required />
            </div>
            <button type="submit" class="btn" style="width: 100%;">Guardar Acumulados</button>
          </form>
        </div>

        <!-- 2. Resultados Baloto -->
        <div class="box">
          <h3>Actualizar Resultado Baloto</h3>
          <form id="form-baloto">
            <div class="balls-inputs">
              <div class="form-group ball-field"><label>Balota 1</label><input type="text" id="edit_b1" maxlength="2" required /></div>
              <div class="form-group ball-field"><label>Balota 2</label><input type="text" id="edit_b2" maxlength="2" required /></div>
              <div class="form-group ball-field"><label>Balota 3</label><input type="text" id="edit_b3" maxlength="2" required /></div>
              <div class="form-group ball-field"><label>Balota 4</label><input type="text" id="edit_b4" maxlength="2" required /></div>
              <div class="form-group ball-field"><label>Balota 5</label><input type="text" id="edit_b5" maxlength="2" required /></div>
              <div class="form-group ball-field super"><label>Súperbalota</label><input type="text" id="edit_b6" maxlength="2" required /></div>
            </div>
            <button type="submit" class="btn" style="width: 100%;">Guardar Baloto</button>
          </form>
        </div>

        <!-- 3. Resultados Revancha -->
        <div class="box">
          <h3>Actualizar Resultado Revancha</h3>
          <form id="form-revancha">
            <div class="balls-inputs">
              <div class="form-group ball-field"><label>Balota 1</label><input type="text" id="edit_r1" maxlength="2" required /></div>
              <div class="form-group ball-field"><label>Balota 2</label><input type="text" id="edit_r2" maxlength="2" required /></div>
              <div class="form-group ball-field"><label>Balota 3</label><input type="text" id="edit_r3" maxlength="2" required /></div>
              <div class="form-group ball-field"><label>Balota 4</label><input type="text" id="edit_r4" maxlength="2" required /></div>
              <div class="form-group ball-field"><label>Balota 5</label><input type="text" id="edit_r5" maxlength="2" required /></div>
              <div class="form-group ball-field super"><label>Súperbalota</label><input type="text" id="edit_r6" maxlength="2" required /></div>
            </div>
            <button type="submit" class="btn" style="width: 100%;">Guardar Revancha</button>
          </form>
        </div>
      </div>
    </div>

    <script is:inline>
      let adminToken = sessionStorage.getItem('adminToken') || '';

      document.getElementById('toggle-pass')?.addEventListener('click', () => {
        const inp = document.getElementById('pass');
        if (inp) inp.type = inp.type === 'password' ? 'text' : 'password';
      });

      function showAlert(id, msg, isError = false) {
        const el = document.getElementById(id);
        if (!el) return;
        el.textContent = msg;
        el.className = 'alert ' + (isError ? 'alert-error' : 'alert-ok');
      }

      async function loadAdminData() {
        const resp = await fetch('/api/admin/acumulados', {
          headers: { Authorization: `Bearer ${adminToken}` }
        });
        if (!resp.ok) {
          sessionStorage.removeItem('adminToken');
          adminToken = '';
          document.getElementById('login-view').style.display = 'block';
          document.getElementById('admin-view').style.display = 'none';
          return;
        }
        const data = await resp.json();
        const row = data.rows?.[0];
        if (!row) return;

        document.getElementById('row_id').value = row.id;
        document.getElementById('edit_acum_3cifras').value = row.acum_3cifras || '';
        document.getElementById('edit_acum_4cifras').value = row.acum_4cifras || '';
        document.getElementById('edit_acum_chmillonario').value = row.acum_chmillonario || '';
        document.getElementById('edit_acum_baloto').value = row.acum_baloto || '';
        document.getElementById('edit_acum_revancha').value = row.acum_revancha || '';

        for (let i = 1; i <= 6; i++) {
          document.getElementById(`edit_b${i}`).value = row[`resul_baloto${i}`] || '';
          document.getElementById(`edit_r${i}`).value = row[`resul_revancha${i}`] || '';
        }

        document.getElementById('login-view').style.display = 'none';
        document.getElementById('admin-view').style.display = 'block';
      }

      document.getElementById('login-form')?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const uname = document.getElementById('uname').value.trim();
        const pass = document.getElementById('pass').value.trim();

        const resp = await fetch('/api/admin/login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ uname, pass })
        });
        const data = await resp.json();
        if (!resp.ok || !data.success) {
          showAlert('login-alert', data.error || 'Error de autenticación', true);
          return;
        }
        adminToken = data.token;
        sessionStorage.setItem('adminToken', adminToken);
        await loadAdminData();
      });

      document.getElementById('btn-logout')?.addEventListener('click', () => {
        sessionStorage.removeItem('adminToken');
        adminToken = '';
        document.getElementById('login-view').style.display = 'block';
        document.getElementById('admin-view').style.display = 'none';
      });

      document.getElementById('form-acumulados')?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const body = {
          id: document.getElementById('row_id').value,
          acum_3cifras: document.getElementById('edit_acum_3cifras').value,
          acum_4cifras: document.getElementById('edit_acum_4cifras').value,
          acum_chmillonario: document.getElementById('edit_acum_chmillonario').value,
          acum_baloto: document.getElementById('edit_acum_baloto').value,
          acum_revancha: document.getElementById('edit_acum_revancha').value
        };
        const resp = await fetch('/api/admin/acumulados', {
          method: 'PUT',
          headers: {
            'Content-Type': 'application/json',
            Authorization: `Bearer ${adminToken}`
          },
          body: JSON.stringify(body)
        });
        const data = await resp.json();
        showAlert('admin-alert', data.message || data.error, !data.success);
      });

      document.getElementById('form-baloto')?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const body = {
          id: document.getElementById('row_id').value,
          resul_baloto1: document.getElementById('edit_b1').value,
          resul_baloto2: document.getElementById('edit_b2').value,
          resul_baloto3: document.getElementById('edit_b3').value,
          resul_baloto4: document.getElementById('edit_b4').value,
          resul_baloto5: document.getElementById('edit_b5').value,
          resul_baloto6: document.getElementById('edit_b6').value
        };
        const resp = await fetch('/api/admin/baloto', {
          method: 'PUT',
          headers: {
            'Content-Type': 'application/json',
            Authorization: `Bearer ${adminToken}`
          },
          body: JSON.stringify(body)
        });
        const data = await resp.json();
        showAlert('admin-alert', data.message || data.error, !data.success);
      });

      document.getElementById('form-revancha')?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const body = {
          id: document.getElementById('row_id').value,
          resul_revancha1: document.getElementById('edit_r1').value,
          resul_revancha2: document.getElementById('edit_r2').value,
          resul_revancha3: document.getElementById('edit_r3').value,
          resul_revancha4: document.getElementById('edit_r4').value,
          resul_revancha5: document.getElementById('edit_r5').value,
          resul_revancha6: document.getElementById('edit_r6').value
        };
        const resp = await fetch('/api/admin/revancha', {
          method: 'PUT',
          headers: {
            'Content-Type': 'application/json',
            Authorization: `Bearer ${adminToken}`
          },
          body: JSON.stringify(body)
        });
        const data = await resp.json();
        showAlert('admin-alert', data.message || data.error, !data.success);
      });

      if (adminToken) {
        loadAdminData();
      }
    </script>
  </body>
</html>
