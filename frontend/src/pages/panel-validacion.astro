---
---
<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Panel de Validación - Resultados de Lotería</title>
    <style>
      :root {
        --bg: #eef2f7;
        --surface: #ffffff;
        --border: #dce3ee;
        --navy: #061b4e;
        --primary: #0d47a1;
        --gold: #f8bb02;
        --muted: #64748b;
        --text: #0f172a;
      }

      * {
        box-sizing: border-box;
      }

      body {
        font-family: 'Segoe UI', system-ui, -apple-system, Roboto, Arial, sans-serif;
        font-variant-numeric: tabular-nums;
        background: var(--bg);
        color: var(--text);
        margin: 0;
        padding: 22px 16px 52px;
      }

      .container {
        max-width: 1220px;
        margin: 0 auto;
      }

      .btn-etl {
        background: rgba(255, 255, 255, 0.16);
        color: #ffffff;
        border: 1px solid rgba(255, 255, 255, 0.35);
        padding: 6px 14px;
        font-size: 13px;
        font-weight: 700;
        border-radius: 8px;
        cursor: pointer;
        transition: all 0.2s;
      }

      .btn-etl:hover:not(:disabled) {
        background: rgba(255, 255, 255, 0.28);
      }

      .btn-etl:disabled {
        opacity: 0.6;
        cursor: not-allowed;
      }

      .hero-header {
        background: linear-gradient(135deg, #061b4e 0%, #0d47a1 100%);
        border-bottom: 3px solid var(--gold);
        border-radius: 16px;
        padding: 22px 26px;
        color: #ffffff;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 16px;
        margin-bottom: 20px;
        box-shadow: 0 12px 28px rgba(6, 27, 78, 0.22);
      }

      .hero-header h1 {
        margin: 0 0 6px;
        font-size: 24px;
        font-weight: 800;
      }

      .hero-header p {
        margin: 0;
        color: #dbeafe;
        font-size: 14px;
      }

      .status-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 12px;
        background: var(--surface);
        border: 1px solid var(--border);
        padding: 16px 20px;
        border-radius: 14px;
        box-shadow: 0 4px 12px rgba(15, 23, 42, 0.04);
        margin-bottom: 20px;
      }

      .badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 14px;
        border-radius: 999px;
        font-weight: 700;
        font-size: 13px;
      }

      .bg-success { background: #dcfce7; color: #166534; }
      .bg-primary { background: #dbeafe; color: #1e40af; }
      .bg-warning { background: #fef3c7; color: #92400e; }
      .bg-danger { background: #fee2e2; color: #991b1b; }

      .btn-sync {
        background: linear-gradient(135deg, #0d47a1 0%, #1565c0 100%);
        color: #ffffff;
        border: none;
        padding: 11px 22px;
        font-size: 15px;
        font-weight: 700;
        border-radius: 10px;
        cursor: pointer;
        box-shadow: 0 4px 12px rgba(13, 71, 161, 0.25);
        transition: all 0.2s;
      }

      .btn-sync:hover:not(:disabled) {
        background: linear-gradient(135deg, #0a3882 0%, #0d47a1 100%);
        transform: translateY(-1px);
      }

      .btn-sync:disabled {
        opacity: 0.65;
        cursor: not-allowed;
      }

      .btn-retry {
        background: #d97706;
        color: #ffffff;
        border: none;
        padding: 11px 18px;
        font-size: 14px;
        font-weight: 700;
        border-radius: 10px;
        cursor: pointer;
        margin-right: 8px;
        display: none;
      }

      .grid-2 {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(360px, 1fr));
        gap: 20px;
        margin-bottom: 20px;
      }

      .grid-3 {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        gap: 20px;
        margin-bottom: 20px;
      }

      .card {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 16px;
        box-shadow: 0 4px 14px rgba(15, 23, 42, 0.05);
        overflow: hidden;
        margin-bottom: 20px;
      }

      .card-header {
        padding: 14px 20px;
        font-weight: 800;
        font-size: 16px;
        color: #ffffff;
        display: flex;
        justify-content: space-between;
        align-items: center;
      }

      .header-blue { background: linear-gradient(135deg, #061b4e 0%, #0d47a1 100%); }
      .header-green { background: linear-gradient(135deg, #14532d 0%, #15803d 100%); }
      .header-dark { background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%); }

      .card-body {
        padding: 20px;
      }

      .balls-row {
        display: flex;
        justify-content: center;
        align-items: center;
        flex-wrap: wrap;
        gap: 10px;
        margin: 10px 0 16px;
      }

      .resultado-numero {
        width: 54px;
        height: 54px;
        border-radius: 50%;
        background: radial-gradient(circle at 32% 28%, #fff7ae 0%, #ffd700 45%, #d99b00 100%);
        color: #0f172a;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 900;
        font-size: 20px;
        box-shadow: 0 6px 12px rgba(0, 0, 0, 0.22), inset 0 2px 4px rgba(255, 255, 255, 0.65);
        border: 2px solid rgba(255, 255, 255, 0.55);
      }

      .resultado-numero.roja {
        background: radial-gradient(circle at 32% 28%, #fca5a5 0%, #dc2626 48%, #7f1d1d 100%);
        color: #ffffff;
      }

      .acum-box {
        text-align: center;
        margin-top: 8px;
      }

      .acum-label {
        font-size: 13px;
        font-weight: 700;
        color: var(--muted);
        margin-bottom: 6px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
      }

      .acum-value {
        display: inline-block;
        padding: 8px 20px;
        border-radius: 10px;
        font-size: 22px;
        font-weight: 900;
        background: #f1f5f9;
        color: var(--navy);
        border: 1px solid var(--border);
      }

      .meta-list p {
        margin: 8px 0;
        font-size: 14px;
        display: flex;
        justify-content: space-between;
        gap: 12px;
        border-bottom: 1px dashed #e2e8f0;
        padding-bottom: 6px;
      }

      .meta-list p:last-child {
        border-bottom: none;
        padding-bottom: 0;
      }

      .terminal-wrap {
        background: #0b1120;
        border-radius: 12px;
        overflow: hidden;
        border: 1px solid #1e293b;
      }

      .terminal-top {
        background: #1e293b;
        padding: 8px 14px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        color: #94a3b8;
        font-size: 12px;
        font-weight: 600;
      }

      .terminal-dots {
        display: flex;
        gap: 6px;
      }

      .terminal-dots span {
        width: 10px;
        height: 10px;
        border-radius: 50%;
      }

      .btn-copy-log {
        border: 1px solid #334155;
        background: #0f172a;
        color: #cbd5e1;
        border-radius: 6px;
        padding: 4px 10px;
        font-size: 12px;
        cursor: pointer;
      }

      .btn-copy-log:hover {
        background: #334155;
        color: #ffffff;
      }

      .log-box {
        color: #e2e8f0;
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
        font-size: 13px;
        line-height: 1.5;
        padding: 14px;
        max-height: 240px;
        overflow-y: auto;
        white-space: pre-wrap;
      }

      .history-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 13px;
      }

      .history-table th,
      .history-table td {
        border-bottom: 1px solid #e2e8f0;
        padding: 10px 12px;
        text-align: left;
      }

      .history-table th {
        background: #f8fafc;
        color: #475569;
        font-weight: 800;
        text-transform: uppercase;
        font-size: 11px;
        letter-spacing: 0.5px;
      }
    </style>
  </head>
  <body>
    <div class="container">
      <div class="hero-header">
        <div>
          <h1>Panel de Validación y Sincronización de Resultados</h1>
          <p>Control centralizado de extracción web, API interna y sincronización verificada con PowerBI</p>
        </div>
        <div>
          <button id="btnRetryPowerBi" class="btn-retry" type="button">
            Reintentar PowerBI Pendiente
          </button>
          <button id="btnActualizar" class="btn-sync" type="button">
            Actualizar ahora
          </button>
        </div>
      </div>

      <div class="status-bar">
        <div>
          <span id="estadoConexion" class="badge bg-success">Sistema Activo</span>
          <span style="margin-left: 12px; font-size: 14px; color: #475569;">
            Última consulta: <strong id="tiempoActualizacion">--</strong> ·
            Extracciones manuales: <strong id="contadorExtracciones">0</strong>
          </span>
        </div>
        <span style="font-size: 12px; color: #64748b; font-weight: 600;">
          Zona horaria operativa: America/Bogota
        </span>
      </div>

      <div class="grid-2">
        <div class="card">
          <div class="card-header header-blue">
            <span>Baloto</span>
            <span style="font-size: 12px; opacity: 0.85;">Código 235</span>
          </div>
          <div class="card-body">
            <div class="balls-row">
              <div id="baloto1" class="resultado-numero">--</div>
              <div id="baloto2" class="resultado-numero">--</div>
              <div id="baloto3" class="resultado-numero">--</div>
              <div id="baloto4" class="resultado-numero">--</div>
              <div id="baloto5" class="resultado-numero">--</div>
              <div id="baloto6" class="resultado-numero roja">--</div>
            </div>
            <div class="acum-box">
              <div class="acum-label">Acumulado Baloto</div>
              <div class="acum-value" id="acum_baloto">$--</div>
            </div>
          </div>
        </div>

        <div class="card">
          <div class="card-header header-blue">
            <span>Revancha</span>
            <span style="font-size: 12px; opacity: 0.85;">Código 2351</span>
          </div>
          <div class="card-body">
            <div class="balls-row">
              <div id="revancha1" class="resultado-numero">--</div>
              <div id="revancha2" class="resultado-numero">--</div>
              <div id="revancha3" class="resultado-numero">--</div>
              <div id="revancha4" class="resultado-numero">--</div>
              <div id="revancha5" class="resultado-numero">--</div>
              <div id="revancha6" class="resultado-numero roja">--</div>
            </div>
            <div class="acum-box">
              <div class="acum-label">Acumulado Revancha</div>
              <div class="acum-value" id="acum_revancha">$--</div>
            </div>
          </div>
        </div>
      </div>

      <div class="grid-3">
        <div class="card">
          <div class="card-header header-green">Doble Chance 3 Cifras (3000)</div>
          <div class="card-body acum-box">
            <div class="acum-value" id="acum_3cifras">$--</div>
          </div>
        </div>

        <div class="card">
          <div class="card-header header-green">Doble Chance 4 Cifras (4000)</div>
          <div class="card-body acum-box">
            <div class="acum-value" id="acum_4cifras">$--</div>
          </div>
        </div>

        <div class="card">
          <div class="card-header header-green">Chance Millonario (5000)</div>
          <div class="card-body acum-box">
            <div class="acum-value" id="acum_chmillonario">$--</div>
          </div>
        </div>
      </div>

      <div class="grid-2">
        <div class="card">
          <div class="card-header header-dark">MiLoto (245), ColorLOTO (273) y Salud de BD</div>
          <div class="card-body meta-list">
            <p><span><strong>MiLoto (245)</strong></span> <strong id="miloto_res">--</strong></p>
            <p><span><strong>ColorLOTO (273)</strong></span> <strong id="colorloto_res">--</strong></p>
            <p><span><strong>BD Principal (chatbot)</strong></span> <strong id="db_main_status">--</strong></p>
            <p><span><strong>BD PowerBI (INFORESULTADOS)</strong></span> <strong id="db_powerbi_status">--</strong></p>
          </div>
        </div>

        <div class="card">
          <div class="card-header header-dark">Estado de Sincronización Automática</div>
          <div class="card-body meta-list">
            <p><span><strong>Estado general</strong></span> <strong id="sync_status_text">--</strong></p>
            <p>
              <span><strong>Última ejecución</strong></span>
              <span><strong id="sync_last_run">--</strong> (<span id="sync_trigger">--</span>)</span>
            </p>
            <p><span><strong>Última exitosa</strong></span> <strong id="sync_last_success">--</strong></p>
            <p><span><strong>Última sync PowerBI</strong></span> <strong id="sync_last_powerbi">--</strong></p>
            <p><span><strong>Próxima programada</strong></span> <strong id="sync_next_run">--</strong></p>
            <p><span><strong>Registros / verificados</strong></span> <strong id="sync_count">--</strong></p>
            <p><span><strong>Duración último ciclo</strong></span> <strong id="sync_duration">--</strong></p>
          </div>
        </div>
      </div>

      <div class="card">
        <div class="card-header header-blue">
          <span>ETL Programado de Loterías (Oficiales, Diarios y Resumen Semanal → chatbot.resultados)</span>
          <button id="btnEjecutarEtl" class="btn-etl" type="button">
            Ejecutar ETL Loterías
          </button>
        </div>
        <div class="card-body">
          <div class="grid-2" style="margin-bottom: 16px;">
            <div class="meta-list">
              <p><span><strong>Programación (America/Bogota)</strong></span> <strong id="etl_schedule">--</strong></p>
              <p><span><strong>Estado ETL</strong></span> <strong id="etl_status_text">--</strong></p>
              <p><span><strong>Fuente utilizada (modo)</strong></span> <strong id="etl_source_used">--</strong></p>
              <p><span><strong>Última franja completada</strong></span> <strong id="etl_last_slot">--</strong></p>
            </div>
            <div class="meta-list">
              <p>
                <span><strong>Última ejecución</strong></span>
                <span><strong id="etl_last_run">--</strong> (<span id="etl_trigger">--</span>)</span>
              </p>
              <p><span><strong>Próxima ejecución programada</strong></span> <strong id="etl_next_run">--</strong></p>
              <p><span><strong>Filas extraídas / guardadas</strong></span> <strong id="etl_rows_count">--</strong></p>
              <p><span><strong>Duración último ETL</strong></span> <strong id="etl_duration">--</strong></p>
            </div>
          </div>

          <div class="terminal-wrap">
            <div class="terminal-top">
              <div class="terminal-dots" aria-hidden="true">
                <span style="background: #ef4444;"></span>
                <span style="background: #f59e0b;"></span>
                <span style="background: #22c55e;"></span>
              </div>
              <span>etl-loterias.log</span>
              <button type="button" id="btnCopyEtlLogs" class="btn-copy-log">Copiar bitácora ETL</button>
            </div>
            <div class="log-box" id="etl_logs">Cargando estado del ETL de loterías...</div>
          </div>
        </div>
      </div>

      <div class="card">
        <div class="card-header header-dark">Bitácora de Sincronización</div>
        <div class="card-body">
          <div class="terminal-wrap">
            <div class="terminal-top">
              <div class="terminal-dots" aria-hidden="true">
                <span style="background: #ef4444;"></span>
                <span style="background: #f59e0b;"></span>
                <span style="background: #22c55e;"></span>
              </div>
              <span>sync-powerbi.log</span>
              <button type="button" id="btnCopyLogs" class="btn-copy-log">Copiar bitácora</button>
            </div>
            <div class="log-box" id="sync_logs">Cargando estado del sistema...</div>
          </div>
        </div>
      </div>

      <div class="card">
        <div class="card-header header-dark">Historial Reciente de Ejecuciones</div>
        <div class="card-body" style="overflow-x: auto; padding: 0;">
          <table class="history-table">
            <thead>
              <tr>
                <th>Fecha / Hora</th>
                <th>Origen</th>
                <th>Estado</th>
                <th>Duración</th>
                <th>PowerBI</th>
                <th>Observación</th>
              </tr>
            </thead>
            <tbody id="sync_history_body">
              <tr><td colspan="6" style="color: #64748b;">Cargando historial...</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <script is:inline>
      let ejecutandoActualizacion = false;
      let contadorActualizaciones = 0;

      const STATUS_LABELS = {
        idle: 'En espera',
        running: 'En ejecución',
        completed: 'Completada',
        completed_fallback: 'Completada (respaldo API)',
        partial: 'Completada (parcial)',
        main_db_error: 'Error en BD Principal',
        powerbi_db_error: 'Error en BD PowerBI (Pendiente)',
        error: 'Error'
      };

      const SOURCE_LABELS = {
        oracle: 'Oracle 11g (BDMM028)',
        internal_api: 'API Interna (respaldo)'
      };

      async function cargarResultados() {
        try {
          const [respDatos, respSync, respEtl] = await Promise.all([
            fetch('/api/datos?t=' + Date.now(), { cache: 'no-store' }),
            fetch('/api/sync/status?t=' + Date.now(), { cache: 'no-store' }),
            fetch('/api/etl/status?t=' + Date.now(), { cache: 'no-store' })
          ]);

          const data = await respDatos.json();
          const syncData = await respSync.json();
          const etlData = await respEtl.json();

          if (data.success && data.data) {
            const baloto = data.data.baloto || {};
            const revancha = data.data.revancha || {};
            const acumulados = data.data.acumulados || {};
            const extra = data.data.extra || {};

            for (let i = 1; i <= 6; i++) {
              const b = baloto[`resul_baloto${i}`];
              const r = revancha[`resul_revancha${i}`];
              const elB = document.getElementById(`baloto${i}`);
              const elR = document.getElementById(`revancha${i}`);
              if (elB && b) elB.textContent = String(b).padStart(2, '0');
              if (elR && r) elR.textContent = String(r).padStart(2, '0');
            }

            if (acumulados.acum_baloto) {
              document.getElementById('acum_baloto').textContent = `$${acumulados.acum_baloto} Millones`;
            }
            if (acumulados.acum_revancha) {
              document.getElementById('acum_revancha').textContent = `$${acumulados.acum_revancha} Millones`;
            }
            if (acumulados.acum_chmillonario) {
              document.getElementById('acum_chmillonario').textContent = `$${acumulados.acum_chmillonario} Millones`;
            }
            if (acumulados.acum_3cifras) {
              document.getElementById('acum_3cifras').textContent = `$${acumulados.acum_3cifras} Millones`;
            }
            if (acumulados.acum_4cifras) {
              document.getElementById('acum_4cifras').textContent = `$${acumulados.acum_4cifras} Millones`;
            }

            if (extra.miloto) document.getElementById('miloto_res').textContent = extra.miloto;
            if (extra.colorloto) document.getElementById('colorloto_res').textContent = extra.colorloto;

            document.getElementById('tiempoActualizacion').textContent = new Date().toLocaleTimeString('es-CO');
          }

          if (syncData && syncData.success) {
            document.getElementById('sync_status_text').textContent =
              STATUS_LABELS[syncData.status] || syncData.status || '--';
            document.getElementById('sync_last_run').textContent = syncData.lastRunAt || '--';
            document.getElementById('sync_trigger').textContent = syncData.lastTrigger || '--';
            document.getElementById('sync_last_success').textContent = syncData.lastSuccessAt || '--';
            document.getElementById('sync_last_powerbi').textContent = syncData.lastPowerBiSyncAt || '--';
            document.getElementById('sync_next_run').textContent = syncData.nextScheduledAt || '--';
            document.getElementById('sync_count').textContent =
              syncData.powerBiSyncedCount !== undefined
                ? `${syncData.powerBiSyncedCount} sincronizados / ${syncData.powerBiVerifiedCount ?? syncData.powerBiSyncedCount} verificados`
                : '--';
            document.getElementById('sync_duration').textContent =
              syncData.durationMs !== null && syncData.durationMs !== undefined ? `${syncData.durationMs} ms` : '--';

            const mainDb = syncData.databases?.mainDb || {};
            const powerBiDb = syncData.databases?.powerBiDb || {};
            document.getElementById('db_main_status').textContent =
              mainDb.status === 'ok' ? 'OK (actualizada)' : mainDb.error || mainDb.status || '--';
            document.getElementById('db_powerbi_status').textContent =
              powerBiDb.status === 'ok'
                ? `OK (${powerBiDb.verifiedCount ?? 0} verificados)`
                : powerBiDb.error || powerBiDb.status || '--';

            const retryBtn = document.getElementById('btnRetryPowerBi');
            if (retryBtn) {
              retryBtn.style.display = syncData.powerBiPendingRetry ? 'inline-block' : 'none';
            }

            if (Array.isArray(syncData.logs) && syncData.logs.length > 0) {
              document.getElementById('sync_logs').textContent = syncData.logs.join('\n');
            }

            const tbody = document.getElementById('sync_history_body');
            if (tbody) {
              tbody.innerHTML = '';
              const hist = Array.isArray(syncData.history) ? syncData.history : [];
              if (hist.length === 0) {
                const tr = document.createElement('tr');
                const td = document.createElement('td');
                td.colSpan = 6;
                td.textContent = 'Sin ejecuciones registradas aún.';
                tr.appendChild(td);
                tbody.appendChild(tr);
              } else {
                hist.slice(0, 10).forEach((item) => {
                  const tr = document.createElement('tr');
                  const cols = [
                    item.runAt || '--',
                    item.trigger || '--',
                    STATUS_LABELS[item.status] || item.status || '--',
                    item.durationMs !== undefined ? `${item.durationMs} ms` : '--',
                    `${item.powerBiSyncedCount ?? 0} / ${item.powerBiVerifiedCount ?? 0}`,
                    Array.isArray(item.errors) && item.errors.length > 0 ? item.errors.join('; ') : 'Sin errores'
                  ];
                  cols.forEach((val, idx) => {
                    const td = document.createElement('td');
                    if (idx === 2) {
                      const pill = document.createElement('span');
                      const stClass =
                        item.status === 'completed'
                          ? 'bg-success'
                          : item.status === 'partial'
                            ? 'bg-warning'
                            : 'bg-danger';
                      pill.className = `badge ${stClass}`;
                      pill.textContent = val;
                      td.appendChild(pill);
                    } else {
                      td.textContent = val;
                    }
                    tr.appendChild(td);
                  });
                  tbody.appendChild(tr);
                });
              }
            }
          }

          if (etlData && etlData.success) {
            document.getElementById('etl_schedule').textContent =
              `${etlData.schedule || '--'} (${etlData.timezone || 'America/Bogota'})`;
            document.getElementById('etl_status_text').textContent =
              STATUS_LABELS[etlData.status] || etlData.status || '--';
            const srcLabel = etlData.sourceUsed ? SOURCE_LABELS[etlData.sourceUsed] || etlData.sourceUsed : 'Sin ejecutar';
            document.getElementById('etl_source_used').textContent = `${srcLabel} (modo: ${etlData.sourceMode || 'auto'})`;
            document.getElementById('etl_last_slot').textContent = etlData.lastCompletedSlotKey || '--';
            document.getElementById('etl_last_run').textContent = etlData.lastRunAt || '--';
            document.getElementById('etl_trigger').textContent = etlData.lastTrigger || '--';
            document.getElementById('etl_next_run').textContent = etlData.nextScheduledAt || '--';
            document.getElementById('etl_rows_count').textContent =
              etlData.rowsExtracted !== undefined
                ? `${etlData.rowsExtracted} extraídas / ${etlData.rowsUpserted ?? 0} guardadas`
                : '--';
            document.getElementById('etl_duration').textContent =
              etlData.durationMs !== null && etlData.durationMs !== undefined ? `${etlData.durationMs} ms` : '--';

            if (Array.isArray(etlData.logs) && etlData.logs.length > 0) {
              document.getElementById('etl_logs').textContent = etlData.logs.join('\n');
            }
          }
        } catch (err) {
          console.error('Error cargando resultados:', err);
        }
      }

      async function ejecutarExtraccionDatos() {
        if (ejecutandoActualizacion) return;
        ejecutandoActualizacion = true;
        contadorActualizaciones++;

        const badge = document.getElementById('estadoConexion');
        const btn = document.getElementById('btnActualizar');
        badge.textContent = `Sincronizando... #${contadorActualizaciones}`;
        badge.className = 'badge bg-primary';
        btn.disabled = true;
        btn.textContent = 'Extrayendo y sincronizando...';

        try {
          const response = await fetch('/api/sync?t=' + Date.now(), {
            method: 'POST',
            headers: {
              'Cache-Control': 'no-cache',
              'X-Requested-With': 'XMLHttpRequest'
            }
          });

          const resJson = await response.json();
          if (resJson.alreadyRunning) {
            badge.textContent = 'Sincronización ya en ejecución';
            badge.className = 'badge bg-primary';
          } else if (response.ok && resJson.success) {
            badge.textContent = `Sincronización Exitosa #${contadorActualizaciones}`;
            badge.className = 'badge bg-success';
          } else {
            badge.textContent = `Advertencia / Error parcial #${contadorActualizaciones}`;
            badge.className = 'badge bg-warning';
          }

          await cargarResultados();
        } catch (err) {
          badge.textContent = `Error #${contadorActualizaciones}`;
          badge.className = 'badge bg-danger';
        } finally {
          ejecutandoActualizacion = false;
          document.getElementById('contadorExtracciones').textContent = String(contadorActualizaciones);
          btn.disabled = false;
          btn.textContent = 'Actualizar ahora';
        }
      }

      async function reintentarPowerBi() {
        const retryBtn = document.getElementById('btnRetryPowerBi');
        const badge = document.getElementById('estadoConexion');
        retryBtn.disabled = true;
        retryBtn.textContent = 'Reintentando PowerBI...';
        try {
          const resp = await fetch('/api/sync/retry-powerbi?t=' + Date.now(), {
            method: 'POST',
            headers: {
              'Cache-Control': 'no-cache',
              'X-Requested-With': 'XMLHttpRequest'
            }
          });
          const data = await resp.json();
          badge.textContent = data.success ? 'PowerBI Recuperado' : 'Reintento PowerBI con error';
          badge.className = data.success ? 'badge bg-success' : 'badge bg-danger';
          await cargarResultados();
        } finally {
          retryBtn.disabled = false;
          retryBtn.textContent = 'Reintentar PowerBI Pendiente';
        }
      }

      async function ejecutarEtlManual() {
        const btn = document.getElementById('btnEjecutarEtl');
        const badge = document.getElementById('estadoConexion');
        if (!btn) return;
        btn.disabled = true;
        btn.textContent = 'Ejecutando ETL...';
        try {
          const resp = await fetch('/api/etl/run?t=' + Date.now(), {
            method: 'POST',
            headers: {
              'Cache-Control': 'no-cache',
              'X-Requested-With': 'XMLHttpRequest'
            }
          });
          const resJson = await resp.json();
          if (resJson.alreadyRunning) {
            badge.textContent = 'ETL ya en ejecución';
            badge.className = 'badge bg-primary';
          } else if (resp.ok && resJson.success) {
            badge.textContent = `ETL Loterías OK (${resJson.rowsUpserted ?? 0} filas)`;
            badge.className = 'badge bg-success';
          } else {
            badge.textContent = 'Error ejecutando ETL Loterías';
            badge.className = 'badge bg-danger';
          }
          await cargarResultados();
        } catch (err) {
          badge.textContent = 'Error ejecutando ETL Loterías';
          badge.className = 'badge bg-danger';
        } finally {
          btn.disabled = false;
          btn.textContent = 'Ejecutar ETL Loterías';
        }
      }

      document.getElementById('btnCopyLogs')?.addEventListener('click', () => {
        const logsText = document.getElementById('sync_logs')?.textContent || '';
        navigator.clipboard?.writeText(logsText);
        const btn = document.getElementById('btnCopyLogs');
        if (btn) {
          btn.textContent = 'Copiado';
          setTimeout(() => {
            btn.textContent = 'Copiar bitácora';
          }, 1500);
        }
      });

      document.getElementById('btnCopyEtlLogs')?.addEventListener('click', () => {
        const logsText = document.getElementById('etl_logs')?.textContent || '';
        navigator.clipboard?.writeText(logsText);
        const btn = document.getElementById('btnCopyEtlLogs');
        if (btn) {
          btn.textContent = 'Copiado';
          setTimeout(() => {
            btn.textContent = 'Copiar bitácora ETL';
          }, 1500);
        }
      });

      document.addEventListener('DOMContentLoaded', () => {
        document.getElementById('btnActualizar')?.addEventListener('click', ejecutarExtraccionDatos);
        document.getElementById('btnRetryPowerBi')?.addEventListener('click', reintentarPowerBi);
        document.getElementById('btnEjecutarEtl')?.addEventListener('click', ejecutarEtlManual);
        cargarResultados();
      });
    </script>
  </body>
</html>
